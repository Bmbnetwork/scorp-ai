# SCORP AI local configuration example
# Copy this file to .env and fill in real values locally.
# Never commit .env.

APP_ENV=local
APP_DEBUG=false
APP_ALLOW_DIAGNOSTICS=false

# PayPal Sandbox configuration
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Basic local abuse protection for the investigation endpoint.
RATE_LIMIT_RETRIEVE_MAX=10
RATE_LIMIT_RETRIEVE_WINDOW=60

# Google Gemini configuration
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Use exact model names returned by:
# php bin/gemini-list-models.php
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# json = enforce Gemini JSON response mode.
# schema = JSON mode plus response schema.
# text = plain text fallback, less reliable.
GEMINI_RESPONSE_MODE=json

GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_OUTPUT_TOKENS=600
GEMINI_MAX_MODEL_ATTEMPTS=3
GEMINI_MAX_TOTAL_REQUESTS=4

# Metadata-only local audit log.
# Records only allow-listed scalar fields such as event, ts, reference,
# outcome, error_code, duration_ms, request_id, http_status, ai_origin,
# ai_available. It never records amounts, statuses, findings text, AI text,
# secrets, tokens, request bodies, or IP addresses.
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DIR=