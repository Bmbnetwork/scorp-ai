# SCORP AI local configuration example
# Copy this file to .env and fill in real values locally.
# Never commit .env.

APP_ENV=local
APP_DEBUG=false
APP_ALLOW_DIAGNOSTICS=false

# PayPal Sandbox configuration
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Basic local abuse protection for the investigation endpoint.
RATE_LIMIT_RETRIEVE_MAX=10
RATE_LIMIT_RETRIEVE_WINDOW=60

# Google Gemini configuration
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# Use exact model names returned by: php bin/gemini-list-models.php
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# json = enforce Gemini JSON response mode. schema = JSON + response schema. text = plain text.
GEMINI_RESPONSE_MODE=json
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_OUTPUT_TOKENS=600
GEMINI_MAX_MODEL_ATTEMPTS=3
GEMINI_MAX_TOTAL_REQUESTS=4

# Local history database (MySQL/MariaDB via XAMPP).
# Run php bin/db-migrate.php once after setting these.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scorp_ai
DB_USER=root
DB_PASS=

# --- Phase 8: audit log + tunable local rate limits ---

# Metadata-only local audit log. Records only allow-listed scalar fields
# (event, ts, reference, outcome, error_code, duration_ms, request_id,
# http_status, format, id, persisted, ai_origin, ai_available, step, count,
# limit, window). It NEVER records amounts, statuses, findings text, AI text,
# secrets, tokens, request bodies, or IP addresses. Files are written to
# var/audit/audit-YYYYMMDD.log (git-ignored). Set false to disable entirely.
AUDIT_LOG_ENABLED=true
# Optional override; defaults to <project>/var/audit when empty.
AUDIT_LOG_DIR=

# Investigation endpoint (already used in earlier phases; listed for clarity).
RATE_LIMIT_RETRIEVE_MAX=10
RATE_LIMIT_RETRIEVE_WINDOW=60

# History endpoint (list / open / remove).
RATE_LIMIT_HISTORY_MAX=60
RATE_LIMIT_HISTORY_WINDOW=60

# Export endpoint (JSON / CSV of a saved investigation).
RATE_LIMIT_EXPORT_MAX=30
RATE_LIMIT_EXPORT_WINDOW=60